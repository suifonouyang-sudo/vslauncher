<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新建虚拟屏"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etW"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="宽"
                android:inputType="number"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etH"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:hint="高"
                android:inputType="number"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDpi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:hint="DPI"
                android:inputType="number"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="创建虚拟屏"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDestroy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="销毁全部"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAutoReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="启动应用后自动返回本桌面"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbBall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示悬浮球（可在任意界面操作虚拟屏）"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScreenInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:text="当前屏幕：读取中…"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/lvDisplays"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:divider="@color/line"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="刷新"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="回到本桌面"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStopTop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="停掉屏上应用"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="加入电池优化白名单（保活）"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnScreenOff"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="关闭屏上应用"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
